{
  "name": "toyosatomiminomiko.github.io",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "type": "module",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "katex": "^0.18.5",
    "three": "^0.185.1",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/three": "^0.185.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "scripts": {
    "dev": "vite",
    "clean": "node -e 'const fs = require(\"node:fs\"); for (const p of [\"dist\", \"math-lab/src/wasm\"]) fs.rmSync(p, { recursive: true, force: true });'",
    "build:wasm:math": "cd math-lab/src/math/math_rs && wasm-pack build --release --target web --out-dir ../../wasm/math_rs",
    "build:wasm:compiler": "cd math-lab/src/compiler/compiler_rs && wasm-pack build --release --target web --out-dir ../../wasm/compiler_rs",
    "build:wasm:render": "cd math-lab/src/render/render_rs && wasm-pack build --release --target web --out-dir ../../wasm/render_rs",
    "build:wasm": "npm run build:wasm:math && npm run build:wasm:compiler && npm run build:wasm:render",
    "build:app": "npm run typecheck && vite build",
    "build": "npm run clean && npm run build:wasm && npm run build:app",
    "lint:rs": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "check": "npm run build:wasm && npm run typecheck:strict && npm test && npm run lint:rs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "typecheck:strict": "tsc --noEmit --noUnusedLocals --noUnusedParameters"
  }
}
