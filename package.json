{
  "name": "toyosatomiminomiko.github.io",
  "version": "0.0.0",
  "private": true,
  "description": "ToyosatomiminoMiko",
  "type": "module",
  "dependencies": {
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "bootstrap": "^5.3.8",
    "katex": "^0.18.5"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "dev": "vite",
    "clean": "node -e 'const fs = require(\"node:fs\"); fs.rmSync(\"dist\", { recursive: true, force: true });'",
    "prepare": "node -e \"try{require('node:child_process').execSync('git config --local core.hooksPath .githooks',{stdio:'ignore'})}catch{}\"",
    "build:app": "npm run typecheck && vite build",
    "build:all": "npm run clean && npm test && npm run build:app",
    "build": "npm run build:all",
    "preview": "vite preview",
    "test": "vitest run",
    "perf:451": "node scripts/perf/451.mjs",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters"
  }
}
