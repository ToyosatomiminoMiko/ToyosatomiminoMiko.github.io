{
    "compilerOptions": {
        "target": "ES2020",
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "allowJs": false,
        "checkJs": false,
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        // 这里只挡住 tsc 对目录的直接 glob: src 里的文件 import 了
        // src/metro_window/wasm 的产物, 那些 import 仍会被解析(skipLibCheck 打开
        // 时也不检查其声明). 删掉这一条不会放宽对源码的检查.
        "src/metro_window/wasm"
    ]
}