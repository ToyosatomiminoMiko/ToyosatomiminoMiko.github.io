// .miko 外层声明式语法.
//
// 这里只负责把一条条声明切出来,数学表达式的优先级与结合性
// 不在这里实现:表达式作为原始片段捕获,交给 Rust 符号引擎归一化.

WHITESPACE = _{ " " | "\t" | "\r" | "\n" | COMMENT }
COMMENT = _{ "//" ~ (!"\n" ~ ANY)* }

ident = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
number = @{ "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }

// 普通表达式:到分号或选项块为止.
expr = @{ (!(";" | "{" | "}") ~ ANY)+ }

// param 的取值需要在 `in [...]` 前截断,这里用前置空白保证
// 不会误伤 `sin(...)` 这类标识符里的 "in".
param_value = @{ (!( " in" ~ (" " | "\t")* ~ "[" | ";" | "{" | "}") ~ ANY)+ }

param_stmt = { "param" ~ ident ~ "=" ~ param_value ~ param_ui? ~ ";" }
param_ui = { "in" ~ "[" ~ number ~ "," ~ number ~ "," ~ number ~ "]" }

tensor_kind = { "scalar" | "vector" | "matrix" | "transform" }
tensor_stmt = { tensor_kind ~ ident ~ "=" ~ expr ~ ";" }

object_kind = { "curve" | "surface" | "vector_field" | "point" | "vector" | "sphere" | "box" | "cylinder" | "cone" | "frustum" }
object_stmt = { object_kind ~ ident ~ "=" ~ expr ~ object_end }
object_end = { options ~ ";"? | ";" }
options = { "{" ~ option* ~ "}" }
option = { ident ~ "=" ~ value ~ ";" }
value = @{ (!(";" | "}") ~ ANY)+ }

analysis_op = { "gradient" | "divergence" | "curl" | "jacobian" | "laplacian" }
op_call = { ident ~ "(" ~ op_arg ~ ")" ~ at? }
op_arg = @{ (!")" ~ ANY)+ }
at = { "at" ~ "[" ~ at_arg ~ ("," ~ at_arg)+ ~ "]" }
at_arg = @{ (!( "," | "]") ~ ANY)+ }
analysis_stmt = { analysis_op ~ ident ~ "=" ~ op_call ~ analysis_end }
analysis_end = { options ~ ";"? | ";" }

integral_stmt = { "integral" ~ ident ~ "=" ~ integral_call ~ integral_end }
integral_call = { "integral" ~ "(" ~ ident ~ ")" }
integral_end = { options ~ ";"? | ";" }

statement = _{ param_stmt | tensor_stmt | object_stmt | analysis_stmt | integral_stmt }
program = { SOI ~ statement* ~ EOI }
