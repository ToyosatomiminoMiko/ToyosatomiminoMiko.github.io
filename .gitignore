# miko_ui 从 npm 装进 node_modules/(package.json 的 "miko_ui": "^0.1.6"),
# 仓库里没有它的本地副本.本地联调(改库的时候)由 scripts/dev_ui_link.sh 把
# node_modules/miko_ui 换成指向工作副本的符号链接,也只落在 node_modules/ 里.

# metro_window 子项目(src/metro_window/)的生成物,生成过程见 package.json 的 build:wasm
# cargo 的构建缓存:workspace 根在仓库根(见根 Cargo.toml),所有成员共用这个 target/
/target
/src/metro_window/wasm
# wasm-bindgen CLI 版本必须与 Cargo.lock 一致,不一致时由构建脚本装到这里
/src/metro_window/.cargo-tools
# cargo test / examples 的可视化产物(ppm 基准图 + preview.png)统一落在这里
/src/metro_window/rust/test_output
